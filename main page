        <!-- Custom Amount Input -->
        <div>
          <label class="text-xs font-bold text-slate-700 block mb-1">Custom Amount ($USD):</label>
          <input type="number" id="customAmountInput" placeholder="Enter custom amount" min="5" class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:ring-2 focus:ring-brandGreen-500 focus:outline-none">
        </div>

        <!-- Personal Info -->
        <div class="space-y-3">
          <input type="text" placeholder="Full Name" required class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:ring-2 focus:ring-brandGreen-500 focus:outline-none">
          <input type="email" placeholder="Email Address for Receipt" required class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:ring-2 focus:ring-brandGreen-500 focus:outline-none">
        </div>

        <!-- Mock Payment Card -->
        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 text-xs text-slate-500 flex items-center justify-between">
          <span class="flex items-center gap-2"><i class="fa-solid fa-lock text-brandGreen-600"></i> Secure Payment Processing</span>
          <div class="flex gap-1.5 text-base text-slate-600">
            <i class="fa-brands fa-cc-visa"></i>
            <i class="fa-brands fa-cc-mastercard"></i>
            <i class="fa-brands fa-cc-apple-pay"></i>
          </div>
        </div>

        <button type="submit" class="w-full bg-brandGreen-600 hover:bg-brandGreen-700 text-white font-bold py-3.5 rounded-xl shadow-lg transition-all text-base">
          Complete Donation
        </button>

      </form>
    </div>
  </div>

  <!-- MODAL 2: VOLUNTEER MODAL -->
  <div id="volunteerModal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl relative border border-slate-100 max-h-[90vh] overflow-y-auto">
      
      <button onclick="closeVolunteerModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl p-2">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <div class="text-center mb-6">
        <div class="w-12 h-12 rounded-full bg-brandBlue-50 text-brandBlue-600 flex items-center justify-center mx-auto text-xl mb-2">
          <i class="fa-solid fa-hands-holding"></i>
        </div>
        <h3 class="text-2xl font-bold text-brandBlue-600">Volunteer Sign-Up</h3>
        <p class="text-xs text-slate-500 mt-1">Join our volunteer team and help strengthen our community!</p>
      </div>

      <form onsubmit="handleVolunteerSubmit(event)" class="space-y-4 text-sm">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">First Name</label>
            <input type="text" required class="w-full px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brandBlue-500 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Last Name</label>
            <input type="text" required class="w-full px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brandBlue-500 focus:outline-none">
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Email Address</label>
          <input type="email" required class="w-full px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brandBlue-500 focus:outline-none">
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Preferred Volunteer Role</label>
          <select required class="w-full px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brandBlue-500 focus:outline-none">
            <option value="sorting">Clothing Sorting & Inventory Processing</option>
            <option value="stylist">High School Student Stylist (Dress for Success)</option>
            <option value="drive">Clothing Drive Organizer</option>
            <option value="general">Wherever Needed Most</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Availability</label>
          <div class="grid grid-cols-2 gap-2 text-xs">
            <label class="flex items-center gap-2 p-2 border rounded-lg"><input type="checkbox"> Weekday Mornings</label>
            <label class="flex items-center gap-2 p-2 border rounded-lg"><input type="checkbox"> Weekday Afternoons</label>
            <label class="flex items-center gap-2 p-2 border rounded-lg"><input type="checkbox"> Saturday Hours</label>
            <label class="flex items-center gap-2 p-2 border rounded-lg"><input type="checkbox"> Special Events</label>
          </div>
        </div>

        <button type="submit" class="w-full bg-brandBlue-600 hover:bg-brandBlue-700 text-white font-bold py-3 rounded-xl shadow transition-colors">
          Submit Volunteer Application
        </button>
      </form>

    </div>
  </div>

  <!-- MODAL 3: NOMINATE STUDENT MODAL -->
  <div id="nominateModal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl relative border border-slate-100 max-h-[90vh] overflow-y-auto">
      
      <button onclick="closeNominateModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl p-2">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <div class="text-center mb-6">
        <div class="w-12 h-12 rounded-full bg-brandGreen-50 text-brandGreen-600 flex items-center justify-center mx-auto text-xl mb-2">
          <i class="fa-solid fa-user-graduate"></i>
        </div>
        <h3 class="text-2xl font-bold text-brandBlue-600">Nominate a Student</h3>
        <p class="text-xs text-slate-500 mt-1">For High School Counselors, Teachers, & Community Liaisons</p>
      </div>

      <form onsubmit="handleNominateSubmit(event)" class="space-y-4 text-sm">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Student First Name or Initial</label>
          <input type="text" placeholder="e.g. Jordan M." required class="w-full px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brandGreen-500 focus:outline-none">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">School Name</label>
            <input type="text" required class="w-full px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brandGreen-500 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Grade Level</label>
            <select class="w-full px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brandGreen-500 focus:outline-none">
              <option>10th Grade</option>
              <option>11th Grade</option>
              <option selected>12th Grade (Senior)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Nominator/Counselor Email</label>
          <input type="email" required class="w-full px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brandGreen-500 focus:outline-none">
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Needs Overview (Interview, Graduation, Career Fair)</label>
          <textarea rows="3" placeholder="Briefly describe upcoming interview or dress requirements..." class="w-full px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brandGreen-500 focus:outline-none"></textarea>
        </div>

        <button type="submit" class="w-full bg-brandGreen-600 hover:bg-brandGreen-700 text-white font-bold py-3 rounded-xl shadow transition-colors">
          Submit Student Referral
        </button>
      </form>

    </div>
  </div>

  <!-- TOAST NOTIFICATION CONTAINER -->
  <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <script>
    // Tab Switch Logic
    function switchTab(tabName) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.getElementById('tab-' + tabName).classList.remove('hidden');

      const tabs = ['donate', 'volunteer', 'partner'];
      tabs.forEach(t => {
        const btn = document.getElementById(`tab-${t}-btn`);
        if (t === tabName) {
          btn.className = "flex-1 py-3 px-4 rounded-xl font-bold text-sm transition-all duration-200 bg-white text-brandBlue-600 shadow-sm";
        } else {
          btn.className = "flex-1 py-3 px-4 rounded-xl font-bold text-sm transition-all duration-200 text-slate-600 hover:text-brandBlue-600";
        }
      });
    }

    // Modal Control Functions
    let selectedAmount = 50;

    function openDonationModal(amount) {
      if (amount) selectModalAmount(amount);
      document.getElementById('donationModal').classList.remove('hidden');
    }
    function closeDonationModal() {
      document.getElementById('donationModal').classList.add('hidden');
    }

    function selectModalAmount(amt) {
      selectedAmount = amt;
      document.querySelectorAll('.amt-btn').forEach(btn => {
        btn.className = "amt-btn border-2 border-slate-200 font-bold py-2 rounded-xl text-slate-700 hover:border-brandGreen-500 transition-all text-sm";
      });
      const targetBtn = document.getElementById(`modal-amt-${amt}`);
      if (targetBtn) {
        targetBtn.className = "amt-btn border-2 border-brandGreen-600 bg-brandGreen-50 font-bold py-2 rounded-xl text-brandGreen-700 transition-all text-sm";
      }

      const impactText = document.getElementById('impactText');
      if (amt === 25) {
        impactText.innerText = "Your $25 gift provides 2 complete seasonal outfits for a school student.";
      } else if (amt === 50) {
        impactText.innerText = "Your $50 gift sponsors 1 High School student with complete interview attire & shoes!";
      } else if (amt === 100) {
        impactText.innerText = "Your $100 gift provides emergency wardrobe bundles for 3 families in transition.";
      } else if (amt === 250) {
        impactText.innerText = "Your $250 gift sponsors a full school pop-up closet & styling drive!";
      }
    }

    function setFrequency(type) {
      const btnOnce = document.getElementById('freq-once');
      const btnMonthly = document.getElementById('freq-monthly');
      if (type === 'once') {
        btnOnce.className = "flex-1 py-2 text-xs font-bold rounded-lg bg-white text-brandBlue-600 shadow-sm";
        btnMonthly.className = "flex-1 py-2 text-xs font-bold rounded-lg text-slate-600";
      } else {
        btnMonthly.className = "flex-1 py-2 text-xs font-bold rounded-lg bg-white text-brandBlue-600 shadow-sm";
        btnOnce.className = "flex-1 py-2 text-xs font-bold rounded-lg text-slate-600";
      }
    }

    function openVolunteerModal() {
      document.getElementById('volunteerModal').classList.remove('hidden');
    }
    function closeVolunteerModal() {
      document.getElementById('volunteerModal').classList.add('hidden');
    }

    function openNominateModal() {
      document.getElementById('nominateModal').classList.remove('hidden');
    }
    function closeNominateModal() {
      document.getElementById('nominateModal').classList.add('hidden');
    }

    // Toast Notification Handler
    function showToast(message, type = 'success') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      toast.className = `pointer-events-auto flex items-center gap-3 px-5 py-4 rounded-2xl shadow-xl text-white font-medium text-sm transition-all transform translate-y-4 opacity-0 ${
        type === 'success' ? 'bg-brandGreen-600' : 'bg-brandBlue-600'
      }`;
      toast.innerHTML = `<i class="fa-solid fa-circle-check text-lg"></i> <span>${message}</span>`;
      container.appendChild(toast);

      setTimeout(() => {
        toast.classList.remove('translate-y-4', 'opacity-0');
      }, 50);

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-4');
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }

    // Form Submission Handlers
    function handleDonationSubmit(e) {
      e.preventDefault();
      closeDonationModal();
      showToast('Thank you for your generous gift to Renewed Beginnings!');
    }

    function handleVolunteerSubmit(e) {
      e.preventDefault();
      closeVolunteerModal();
      showToast('Volunteer application submitted! Our team will email you shortly.');
    }

    function handleNominateSubmit(e) {
      e.preventDefault();
      closeNominateModal();
      showToast('Student nomination received! We will follow up with the counselor.');
    }

    function handlePartnerSubmit(e) {
      e.preventDefault();
      showToast('Partner inquiry received! Thank you for connecting with us.');
      e.target.reset();
    }

    // Mobile Menu Drawer Control
    const mobileBtn = document.getElementById('mobileMenuBtn');
    const mobileDrawer = document.getElementById('mobileDrawer');
    const closeDrawerBtn = document.getElementById('closeMobileDrawer');

    if (mobileBtn && mobileDrawer) {
      mobileBtn.addEventListener('click', () => mobileDrawer.classList.remove('hidden'));
      closeDrawerBtn.addEventListener('click', () => mobileDrawer.classList.add('hidden'));
      
      document.querySelectorAll('.mobile-nav-link').forEach(link => {
        link.addEventListener('click', () => mobileDrawer.classList.add('hidden'));
      });
    }
  </script>
</body>
</html>
